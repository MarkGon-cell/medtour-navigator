# Copy to `.env` and fill in. Never commit the filled-in file.
#
# NOTE: `backend/.env` is currently tracked in git with a live
# NVIDIA_NIM_API_KEY in it. Rotate that key and untrack the file
# (`git rm --cached backend/.env`) before this repo goes further.

# Postgres, e.g. postgresql://postgres:password@localhost:5432/medtour_db
DATABASE_URL=

# JWT settings for the deprecated /auth routes (Phase 4 removal).
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional — NVIDIA NIM chat completion for /ai/analyze triage.
NVIDIA_NIM_API_KEY=

# Optional — enables Geoapify as the second hospital-search provider in
# GET /hospitals/discover. Free tier, 3,000 requests/day, no card:
# https://www.geoapify.com/pricing/
#
# Without it the endpoint reports `"geoapify": "no_api_key"` and runs
# Overpass-only. That is a supported state, not an error.
GEOAPIFY_API_KEY=

# Optional — REAL hospital ratings + review counts via Google Places (New),
# used by /ai/analyze so reputation prefers a sourced rating over inference.
# Rate-limited, cached 7 days, circuit-broken: safe on a demo/trial key.
# NOTE: Places needs a billing-enabled Cloud project; a restricted docs
# "demo" key is rejected and the system silently falls back to inferred
# reputation. Leave unset to run inference-only.
GOOGLE_PLACES_API_KEY=
# Optional tuning (defaults shown):
# GOOGLE_PLACES_RATE_PER_MINUTE=6
# GOOGLE_PLACES_DAILY_BUDGET=300
# GOOGLE_PLACES_MAX_PLACES=20

# Optional — enables directory writes. POST /hospitals/ and
# POST /hospitals/{id}/queue return 403 while this is unset, so writes are
# off by default. Leave unset unless you intend to publish directory rows.
HOSPITAL_WRITE_KEY=
